[Unit]
Description=Local inline completion daemon
After=ollama.service

[Service]
ExecStart=%h/.local/bin/omarchy-inline serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/omarchy-inline %t/omarchy-inline

[Install]
WantedBy=graphical-session.target
